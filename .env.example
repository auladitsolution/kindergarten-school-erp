# ==============================================================================
# KINDERGARTEN SCHOOL ERP - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_NAME="Bloom Kindergarten & Junior Academy"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="bn" # 'bn' (Bangla) or 'en' (English)

# Database - MongoDB Atlas
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/kindergarten_erp?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017/kindergarten_school"

# Firebase Authentication (Client Side)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyDummyKeyForDevelopment123456789"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="kindergarten-school-demo.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="kindergarten-school-demo"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="kindergarten-school-demo.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Firebase Admin SDK (Server Side)
FIREBASE_PROJECT_ID="kindergarten-school-demo"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@kindergarten-school-demo.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC3...\n-----END PRIVATE KEY-----\n"

# Cloudinary Media Storage
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="demo-kindergarten"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="dummy_cloudinary_api_secret_key"

# App Security & Sessions
JWT_SECRET="kindergarten_secure_session_secret_key_2026_super_safe_random"
SESSION_COOKIE_NAME="kindergarten_session"

# Demo Mode Enabled (Allows immediate local full evaluation if external keys aren't yet provisioned)
NEXT_PUBLIC_DEMO_MODE="true"
